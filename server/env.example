# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/oushodghor?retryWrites=true&w=majority

# Any long random string (used to sign login tokens)
JWT_SECRET=change_this_to_a_long_random_secret

# Port (Render sets this automatically, safe to leave as is)
PORT=5000

# First admin account created by "npm run seed"
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Admin
